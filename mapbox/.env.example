# Empty uses the Vite same-origin proxy during local development.
VITE_API_BASE_URL=

# Required to obtain the public booking token from FastAPI.
VITE_PUBLIC_API_KEY=replace-with-the-backend-public-api-key

# Used only on localhost when no ?tenant= query parameter is supplied.
VITE_TENANT_SUBDOMAIN=simplydemo

# Production and normal development must remain false.
VITE_MOCK_API=false
