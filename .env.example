# App Configuration
APP_ENV=development
PROJECT_NAME="FastAPI Bookings"

# Database Configuration
# For local SQLite: sqlite:///./fastapi_bookings.db (development only)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/fastapi_bookings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi_bookings

# Security Configuration
SECRET_KEY=changeme_locally
PUBLIC_API_KEY=local-public-key-change-me

# Frontend
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# ClickSend SMS Settings
CLICKSEND_API_USERNAME=
CLICKSEND_API_KEY=

# Stripe Settings
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Settings
FIREBASE_CREDENTIALS_JSON=firebase-credentials.json

# Mapbox Settings
MAPBOX_ACCESS_TOKEN=
